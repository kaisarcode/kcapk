package @PACKAGE_NAME@;

import android.app.Activity;
import android.content.Intent;
import android.content.res.Resources;
import android.os.Bundle;
import android.view.Window;
import android.view.WindowManager;
import android.webkit.WebView;

public class MainActivity extends Activity {
    private WebView webView;
    private JSBridge bridge;
    private KcapkAppExtension extension;
    private KcapkWebChromeClient chromeClient;
    private static final String WEBVIEW_URL = "@WEBVIEW_URL@";
    private static final String JS_INTERFACE_NAME = "AndroidBridge";
    private static final String[] TRUSTED_ORIGINS = { @TRUSTED_ORIGINS@ };
    private static final boolean IS_FULLSCREEN = @IS_FULLSCREEN@;
    private static final boolean LOCAL_HTTPS_ASSETS = @LOCAL_HTTPS_ASSETS@;
    private static final String APP_BACKGROUND = "@BACKGROUND@";

    @Override
    public void onCreate(Bundle savedInstanceState) {
        if (IS_FULLSCREEN) {
            requestWindowFeature(Window.FEATURE_NO_TITLE);
            getWindow().setFlags(
                WindowManager.LayoutParams.FLAG_FULLSCREEN,
                WindowManager.LayoutParams.FLAG_FULLSCREEN
            );
        }

        super.onCreate(savedInstanceState);
        Resources res = getResources();

        int layoutResId = res.getIdentifier("activity_main", "layout", getPackageName());
        setContentView(layoutResId);

        int webViewResId = res.getIdentifier("webview", "id", getPackageName());
        webView = (WebView) findViewById(webViewResId);

        if (!APP_BACKGROUND.isEmpty()) {
            int appBackground = android.graphics.Color.parseColor(APP_BACKGROUND);
            getWindow().setStatusBarColor(appBackground);
            getWindow().setNavigationBarColor(appBackground);
            webView.setBackgroundColor(appBackground);
        }

        webView.getSettings().setJavaScriptEnabled(true);
        webView.getSettings().setDomStorageEnabled(true);
        webView.getSettings().setCacheMode(android.webkit.WebSettings.LOAD_NO_CACHE);
        webView.getSettings().setUseWideViewPort(true);
        webView.getSettings().setLoadWithOverviewMode(true);
        webView.setVerticalScrollBarEnabled(false);

        bridge = new JSBridge(this, webView, TRUSTED_ORIGINS);
        // @KCAPK_API:intents@
        bridge.onNewIntent(getIntent());
        // @KCAPK_END_API@
        webView.setWebViewClient(new TrustedWebViewClient(this, TRUSTED_ORIGINS, bridge, LOCAL_HTTPS_ASSETS));
        chromeClient = new KcapkWebChromeClient(this, webView, TRUSTED_ORIGINS);
        webView.setWebChromeClient(chromeClient);
        webView.addJavascriptInterface(bridge, JS_INTERFACE_NAME);
        extension = new KcapkAppExtension(this, webView);
        extension.attach();
        webView.loadUrl(WEBVIEW_URL);
    }

    // @KCAPK_API:intents@
    @Override
    protected void onNewIntent(Intent intent) {
        super.onNewIntent(intent);
        setIntent(intent);
        if (bridge != null) {
            bridge.onNewIntent(intent);
        }
    }
    // @KCAPK_END_API@

    // @KCAPK_API:permissions@
    @Override
    public void onRequestPermissionsResult(int requestCode, String[] permissions, int[] grantResults) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults);
        if (bridge != null) {
            bridge.onRequestPermissionsResult(requestCode, permissions, grantResults);
        }
    }
    // @KCAPK_END_API@

    @Override
    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
        super.onActivityResult(requestCode, resultCode, data);
        if (extension != null && extension.onActivityResult(requestCode, resultCode, data)) return;
        if (chromeClient != null && chromeClient.onActivityResult(requestCode, resultCode, data)) return;
        // @KCAPK_API:async@
        if (bridge != null) {
            bridge.onActivityResult(requestCode, resultCode, data);
        }
        // @KCAPK_END_API@
    }

    // @KCAPK_API:permissions@
    @Override
    protected void onResume() {
        super.onResume();
        if (bridge != null) {
            bridge.onResume();
        }
    }
    // @KCAPK_END_API@

    @Override
    protected void onDestroy() {
        if (extension != null) extension.destroy();
        if (chromeClient != null) chromeClient.cancelFileChooser();
        if (bridge != null) {
            bridge.destroy();
        }
        if (webView != null) {
            webView.removeJavascriptInterface(JS_INTERFACE_NAME);
            webView.destroy();
        }
        super.onDestroy();
    }

    @Override
    public void onBackPressed() {
        if (extension != null && extension.onBackPressed()) return;
        if (webView != null && webView.canGoBack()) { webView.goBack(); } else { super.onBackPressed(); }
    }
}
