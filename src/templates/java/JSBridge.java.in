package @PACKAGE_NAME@;

import android.app.Activity;
import android.content.Context;
import android.content.Intent;
import android.net.ConnectivityManager;
import android.net.NetworkInfo;
import android.webkit.JavascriptInterface;
import android.webkit.WebView;
import android.widget.Toast;
import java.net.URI;
import java.util.concurrent.atomic.AtomicLong;

public class JSBridge {
    private static final String LOCAL_ASSET_PREFIX = "file:///android_asset/";
    // @KCAPK_API:exec@
    private static final String[] EXECUTABLE_NAMES = { @EXECUTABLE_NAMES@ };
    // @KCAPK_END_API@
    private final Context context;
    private final String[] trustedOrigins;
    // @KCAPK_API:async@
    private final AsyncBridge asyncBridge;
    // @KCAPK_END_API@
    // @KCAPK_API:exec@
    private final ExecBridge execBridge;
    // @KCAPK_END_API@
    // @KCAPK_API:permissions@
    private final PermissionBridge permissionBridge;
    // @KCAPK_END_API@
    // @KCAPK_API:notifications@
    private final NotificationBridge notificationBridge;
    // @KCAPK_END_API@
    // @KCAPK_API:alarms@
    private final AlarmBridge alarmBridge;
    // @KCAPK_END_API@
    // @KCAPK_API:haptics@
    private final HapticBridge hapticBridge;
    // @KCAPK_END_API@
    // @KCAPK_API:intents@
    private final IntentBridge intentBridge;
    // @KCAPK_END_API@
    // @KCAPK_API:files@
    private final FileBridge fileBridge;
    // @KCAPK_END_API@
    // @KCAPK_API:apps@
    private final AppBridge appBridge;
    // @KCAPK_END_API@
    // @KCAPK_API:resources@
    private final ResourceBridge resourceBridge;
    // @KCAPK_END_API@
    // @KCAPK_API:systemUI@
    private final SystemUIBridge systemUIBridge;
    // @KCAPK_END_API@
    // @KCAPK_API:clipboard@
    private final ClipboardBridge clipboardBridge;
    // @KCAPK_END_API@
    // @KCAPK_API:screen@
    private final ScreenBridge screenBridge;
    // @KCAPK_END_API@
    // @KCAPK_API:voice@
    private final VoiceBridge voiceBridge;
    // @KCAPK_END_API@
    private final AtomicLong pageGeneration = new AtomicLong(0L);
    private volatile boolean bridgeAllowed;

    public JSBridge(Context context, WebView webView, String[] trustedOrigins) {
        this.context = context;
        this.trustedOrigins = trustedOrigins;
        // @KCAPK_API:async@
        this.asyncBridge = new AsyncBridge((Activity) context, webView);
        // @KCAPK_END_API@
        // @KCAPK_API:exec@
        this.execBridge = new ExecBridge(context, asyncBridge, EXECUTABLE_NAMES);
        // @KCAPK_END_API@
        // @KCAPK_API:permissions@
        this.permissionBridge = new PermissionBridge(context, asyncBridge);
        // @KCAPK_END_API@
        // @KCAPK_API:notifications@
        this.notificationBridge = new NotificationBridge(context);
        // @KCAPK_END_API@
        // @KCAPK_API:alarms@
        this.alarmBridge = new AlarmBridge(context);
        // @KCAPK_END_API@
        // @KCAPK_API:haptics@
        this.hapticBridge = new HapticBridge(context);
        // @KCAPK_END_API@
        // @KCAPK_API:intents@
        this.intentBridge = new IntentBridge(context);
        // @KCAPK_END_API@
        // @KCAPK_API:files@
        this.fileBridge = new FileBridge((Activity) context, asyncBridge);
        // @KCAPK_END_API@
        // @KCAPK_API:apps@
        this.appBridge = new AppBridge(context, asyncBridge);
        // @KCAPK_END_API@
        // @KCAPK_API:resources@
        this.resourceBridge = new ResourceBridge(context, asyncBridge);
        // @KCAPK_END_API@
        // @KCAPK_API:systemUI@
        this.systemUIBridge = new SystemUIBridge(context);
        // @KCAPK_END_API@
        // @KCAPK_API:clipboard@
        this.clipboardBridge = new ClipboardBridge(context);
        // @KCAPK_END_API@
        // @KCAPK_API:screen@
        this.screenBridge = new ScreenBridge(context);
        // @KCAPK_END_API@
        // @KCAPK_API:voice@
        this.voiceBridge = new VoiceBridge((Activity) context, asyncBridge);
        // @KCAPK_END_API@
    }

    public static boolean isTrustedUrl(String url, String[] trustedOrigins) {
        if (url == null || url.isEmpty()) {
            return false;
        }

        if (url.startsWith(LOCAL_ASSET_PREFIX)) {
            return true;
        }

        try {
            URI parsedUrl = URI.create(url);
            String origin = normalizeOrigin(parsedUrl);

            if (origin == null) {
                return false;
            }

            for (String trustedOrigin : trustedOrigins) {
                try {
                    URI trustedUri = URI.create(trustedOrigin);
                    String normalizedTrusted = normalizeOrigin(trustedUri);
                    if (normalizedTrusted != null && origin.equals(normalizedTrusted)) {
                        return true;
                    }
                } catch (IllegalArgumentException ignored) {
                    if (origin.equals(trustedOrigin)) {
                        return true;
                    }
                }
            }
        } catch (IllegalArgumentException ignored) {
            return false;
        }

        return false;
    }

    private static String normalizeOrigin(URI uri) {
        String scheme = uri.getScheme();
        String host = uri.getHost();

        if (scheme == null || host == null) {
            return null;
        }

        scheme = scheme.toLowerCase();
        host = host.toLowerCase();
        if (host.startsWith("www.")) {
            host = host.substring(4);
        }

        int port = uri.getPort();
        if (port == -1) {
            return scheme + "://" + host;
        }

        return scheme + "://" + host + ":" + port;
    }

    public long beginPage(String url) {
        bridgeAllowed = isTrustedUrl(url, trustedOrigins);
        long generation = pageGeneration.incrementAndGet();
        // @KCAPK_API:async@
        asyncBridge.setGeneration(generation);
        // @KCAPK_END_API@
        // @KCAPK_API:exec@
        execBridge.cancelStale(generation);
        // @KCAPK_END_API@
        return generation;
    }

    public long getPageGeneration() {
        return pageGeneration.get();
    }

    private boolean canUseBridge() {
        return bridgeAllowed;
    }

    // @KCAPK_API:exec@
    @JavascriptInterface
    public boolean exec(long requestId, long generation, String json) {
        return canUseBridge() && execBridge.start(requestId, generation, json);
    }
    // @KCAPK_END_API@

    @JavascriptInterface
    public void showToast(String message) {
        if (!canUseBridge()) {
            return;
        }
        Toast.makeText(context, message, Toast.LENGTH_SHORT).show();
    }

    // @KCAPK_API:network@
    @JavascriptInterface
    public boolean isOnline() {
        if (!canUseBridge()) {
            return false;
        }

        ConnectivityManager cm = (ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE);
        if (cm != null) {
            NetworkInfo netInfo = cm.getActiveNetworkInfo();
            return netInfo != null && netInfo.isConnected();
        }
        return false;
    }
    // @KCAPK_END_API@

    // @KCAPK_API:permissions@
    @JavascriptInterface
    public boolean permissionHas(String name) {
        return canUseBridge() && permissionBridge.has(name);
    }

    @JavascriptInterface
    public boolean permissionRequest(long requestId, long generation, String name) {
        return canUseBridge() && permissionBridge.request(requestId, generation, name);
    }
    // @KCAPK_END_API@

    // @KCAPK_API:notifications@
    @JavascriptInterface
    public boolean notificationCanPost() {
        return canUseBridge() && notificationBridge.canPost();
    }

    @JavascriptInterface
    public boolean notificationCreateChannel(String json) {
        return canUseBridge() && notificationBridge.createChannel(json);
    }

    @JavascriptInterface
    public boolean notificationPost(String json) {
        return canUseBridge() && notificationBridge.post(json);
    }

    @JavascriptInterface
    public boolean notificationCancel(int id) {
        return canUseBridge() && notificationBridge.cancel(id);
    }

    @JavascriptInterface
    public boolean notificationCancelAll() {
        return canUseBridge() && notificationBridge.cancelAll();
    }
    // @KCAPK_END_API@

    // @KCAPK_API:alarms@
    @JavascriptInterface
    public boolean alarmCanScheduleExact() {
        return canUseBridge() && alarmBridge.canScheduleExact();
    }

    @JavascriptInterface
    public boolean alarmSchedule(String json) {
        return canUseBridge() && alarmBridge.schedule(json);
    }

    @JavascriptInterface
    public boolean alarmCancel(int id) {
        return canUseBridge() && alarmBridge.cancel(id);
    }

    @JavascriptInterface
    public boolean alarmCancelAll() {
        return canUseBridge() && alarmBridge.cancelAll();
    }
    // @KCAPK_END_API@

    // @KCAPK_API:haptics@
    @JavascriptInterface
    public boolean hapticHasVibrator() {
        return canUseBridge() && hapticBridge.hasVibrator();
    }

    @JavascriptInterface
    public boolean hapticVibrate(long milliseconds) {
        return canUseBridge() && hapticBridge.vibrate(milliseconds);
    }

    @JavascriptInterface
    public boolean hapticEffect(String name) {
        return canUseBridge() && hapticBridge.effect(name);
    }

    @JavascriptInterface
    public boolean hapticCancel() {
        return canUseBridge() && hapticBridge.cancel();
    }
    // @KCAPK_END_API@

    // @KCAPK_API:intents@
    @JavascriptInterface
    public boolean intentShare(String json) {
        return canUseBridge() && intentBridge.share(json);
    }

    @JavascriptInterface
    public boolean intentOpenUrl(String url) {
        return canUseBridge() && intentBridge.openUrl(url);
    }

    @JavascriptInterface
    public boolean intentOpenAppSettings() {
        return canUseBridge() && intentBridge.openAppSettings();
    }

    @JavascriptInterface
    public String intentConsumeShare() {
        return canUseBridge() ? intentBridge.consumeShare() : "";
    }
    // @KCAPK_END_API@

    // @KCAPK_API:files@
    @JavascriptInterface
    public boolean fileOpen(long requestId, long generation, String json) {
        return canUseBridge() && fileBridge.open(requestId, generation, json);
    }
    // @KCAPK_END_API@

    // @KCAPK_API:apps@
    @JavascriptInterface
    public boolean appsList(long requestId, long generation) {
        return canUseBridge() && appBridge.list(requestId, generation);
    }

    @JavascriptInterface
    public boolean appsIcon(
        long requestId,
        long generation,
        String packageName,
        String activityName
    ) {
        return canUseBridge() && appBridge.icon(requestId, generation, packageName, activityName);
    }

    @JavascriptInterface
    public boolean appsLaunch(String packageName, String activityName) {
        return canUseBridge() && appBridge.launch(packageName, activityName);
    }

    @JavascriptInterface
    public boolean appsHomeEnabled() {
        return canUseBridge() && appBridge.homeEnabled();
    }

    @JavascriptInterface
    public boolean appsSetHomeEnabled(boolean enabled) {
        return canUseBridge() && appBridge.setHomeEnabled(enabled);
    }

    @JavascriptInterface
    public boolean appsOpenHomeSettings() {
        return canUseBridge() && appBridge.openHomeSettings();
