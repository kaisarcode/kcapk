    // @KCAPK_END_API@

    // @KCAPK_API:resources@
    @JavascriptInterface
    public boolean resourcesDescribe(
        long requestId,
        long generation,
        String packageName,
        int resourceId
    ) {
        return canUseBridge() && resourceBridge.describe(requestId, generation, packageName, resourceId);
