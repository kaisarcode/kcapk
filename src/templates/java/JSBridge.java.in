    // @KCAPK_END_API@

    // @KCAPK_API:permissions@
    public void onRequestPermissionsResult(int requestCode, String[] permissions, int[] grantResults) {
        permissionBridge.onRequestPermissionsResult(requestCode, permissions, grantResults);
    }
    // @KCAPK_END_API@

    // @KCAPK_API:async@
    public void onActivityResult(int requestCode, int resultCode, Intent data) {
        asyncBridge.onActivityResult(requestCode, resultCode, data);
    }
    // @KCAPK_END_API@

    // @KCAPK_API:intents@
    public void onNewIntent(Intent intent) {
        intentBridge.receive(intent);
    }
    // @KCAPK_END_API@

    // @KCAPK_API:permissions@
    public void onResume() {
        permissionBridge.onResume();
    }
    // @KCAPK_END_API@

    public void destroy() {
        // @KCAPK_API:permissions@
        permissionBridge.destroy();
        // @KCAPK_END_API@
        // @KCAPK_API:exec@
        execBridge.destroy();
        // @KCAPK_END_API@
        // @KCAPK_API:apps@
        appBridge.destroy();
        // @KCAPK_END_API@
        // @KCAPK_API:resources@
        resourceBridge.destroy();
        // @KCAPK_END_API@
        // @KCAPK_API:async@
        asyncBridge.destroy();
        // @KCAPK_END_API@
    }
}
