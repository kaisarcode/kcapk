package @PACKAGE_NAME@;

import android.content.Context;
import android.content.Intent;
import android.net.Uri;
import android.webkit.WebResourceRequest;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import android.webkit.WebResourceResponse;
import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.util.Collections;
import java.io.BufferedReader;
import java.io.InputStream;
import java.io.InputStreamReader;

public class TrustedWebViewClient extends WebViewClient {
    private static final String NATIVE_BRIDGE_RESOURCE = "native_bridge";
    private final Context context;
    private final String[] trustedOrigins;
    private final JSBridge bridge;
    private final boolean localHttpsAssets;
    private final String nativeBridgeScript;

    public TrustedWebViewClient(Context context, String[] trustedOrigins, JSBridge bridge, boolean localHttpsAssets) {
        this.context = context;
        this.localHttpsAssets = localHttpsAssets;
        this.trustedOrigins = trustedOrigins;
        this.bridge = bridge;
        this.nativeBridgeScript = loadBridgeScript(context);
    }

    // Opt-in local HTTPS origin. Assets are served from the APK, never a server.
    @Override
    public WebResourceResponse shouldInterceptRequest(WebView view, WebResourceRequest request) {
        if (!localHttpsAssets) return super.shouldInterceptRequest(view, request);
        Uri uri = request.getUrl();
        if (!"https".equals(uri.getScheme())
                || !"appassets.androidplatform.net".equals(uri.getHost())
                || uri.getPort() != -1) {
            return super.shouldInterceptRequest(view, request);
        }
        String path = uri.getPath();
        if (path == null || !path.matches("/[a-zA-Z0-9_./-]+") || path.contains("..")) {
            return missingAsset();
        }
        String name = path.substring(1);
        String mime = "application/octet-stream";
        if (name.endsWith(".html")) mime = "text/html";
        else if (name.endsWith(".css")) mime = "text/css";
        else if (name.endsWith(".js")) mime = "text/javascript";
        else if (name.endsWith(".svg")) mime = "image/svg+xml";
        else if (name.endsWith(".mp3")) mime = "audio/mpeg";
        else if (name.endsWith(".png")) mime = "image/png";
        else if (name.endsWith(".jpg") || name.endsWith(".jpeg")) mime = "image/jpeg";
        else if (name.endsWith(".json")) mime = "application/json";
        try {
            return new WebResourceResponse(mime, mime.startsWith("text/") ? "UTF-8" : null,
                200, "OK", Collections.singletonMap("Cache-Control", "no-store, no-cache, must-revalidate"),
                context.getAssets().open(name));
        } catch (IOException ignored) {
            return missingAsset();
        }
    }

    private static WebResourceResponse missingAsset() {
        return new WebResourceResponse("text/plain", "UTF-8", 404, "Not Found",
            Collections.emptyMap(), new ByteArrayInputStream(new byte[0]));
    }

    private boolean openExternally(String url) {
        try {
            context.startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(url)));
            return true;
        } catch (Exception ignored) {
            return true;
        }
    }

    private boolean handleNavigation(String url) {
        if (JSBridge.isTrustedUrl(url, trustedOrigins)) {
            return false;
        }

        return openExternally(url);
    }

    private void installBridge(WebView view, String url, long generation) {
        if (!JSBridge.isTrustedUrl(url, trustedOrigins) || nativeBridgeScript.isEmpty()) {
            return;
        }

        String script = nativeBridgeScript +
            "\n;if(window.NativeBridge&&window.NativeBridge.__kcapk){" +
            "window.NativeBridge.__setGeneration(" + generation + ");}";
        view.evaluateJavascript(script, null);
    }

    @Override
    public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
        if (!request.isForMainFrame()) {
            return false;
        }

        return handleNavigation(request.getUrl().toString());
    }

    @Override
    public void onPageStarted(WebView view, String url, android.graphics.Bitmap favicon) {
        long generation = bridge.beginPage(url);
        installBridge(view, url, generation);
        super.onPageStarted(view, url, favicon);
    }

    @Override
    public void onPageFinished(WebView view, String url) {
        installBridge(view, url, bridge.getPageGeneration());
        super.onPageFinished(view, url);
    }

    private static String loadBridgeScript(Context context) {
        int resourceId = context.getResources().getIdentifier(
            NATIVE_BRIDGE_RESOURCE,
            "raw",
            context.getPackageName()
        );
        if (resourceId == 0) {
            return "";
        }

        StringBuilder script = new StringBuilder();
        try (
            InputStream input = context.getResources().openRawResource(resourceId);
            BufferedReader reader = new BufferedReader(new InputStreamReader(input))
        ) {
            String line;
            while ((line = reader.readLine()) != null) {
                script.append(line).append('\n');
            }
            return script.toString();
        } catch (Exception ignored) {
            return "";
        }
    }
}
