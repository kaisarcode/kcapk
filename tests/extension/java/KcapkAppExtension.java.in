package @PACKAGE_NAME@;

import android.app.Activity;
import android.content.Intent;
import android.webkit.JavascriptInterface;
import android.webkit.WebView;
import java.util.concurrent.atomic.AtomicInteger;

/** Simple application-owned extension for the KCAPK integration APK. */
public final class KcapkAppExtension {
    private final WebView webView;

    public KcapkAppExtension(Activity activity, WebView webView) {
        this.webView = webView;
    }

    public void attach() {
        webView.addJavascriptInterface(new TestExtensionBridge(), "KcapkTestExtension");
    }

    public boolean onActivityResult(int requestCode, int resultCode, Intent data) {
        return false;
    }

    public boolean onBackPressed() {
        return false;
    }

    public void destroy() {
        webView.removeJavascriptInterface("KcapkTestExtension");
    }

    public static final class TestExtensionBridge {
        private final AtomicInteger callCount = new AtomicInteger();

        // JavascriptInterface methods execute on the WebView bridge thread,
        // not the Android UI thread. This diagnostic has no privileged access
        // and deliberately does not touch WebView state.
        @JavascriptInterface
        public String ping() {
            return "Custom app API OK (" + callCount.incrementAndGet() + ")";
        }
    }
}
